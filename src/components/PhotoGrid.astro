---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/site';

interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'webp', quality: 82 }),
  })),
);
---

<ul class="masonry">
  {
    items.map((p, i) => (
      <li class="masonry-item reveal" data-category={p.category} style={`--delay:${(i % 3) * 60}ms`}>
        <a href={p.full.src} class="photo-card" data-lb-item data-title={p.title} data-alt={p.alt}>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw"
            format="webp"
            quality={78}
            loading={i < 3 ? 'eager' : 'lazy'}
          />
          <span class="photo-meta">
            <span class="photo-title">{p.title}</span>
            <span class="photo-cat">{p.category}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 16px;
  }

  @media (min-width: 700px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 1100px) {
    .masonry {
      columns: 3;
      column-gap: 20px;
    }
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 16px;
  }

  .masonry-item[hidden] {
    display: none;
  }

  .photo-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: zoom-in;
  }

  .photo-card img {
    width: 100%;
    transition:
      transform 700ms var(--ease-out),
      filter 700ms var(--ease-out);
  }

  .photo-meta {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    padding: 48px 18px 16px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .photo-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .photo-cat {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .photo-card:hover img,
  .photo-card:focus-visible img {
    transform: scale(1.04);
  }

  .photo-card:hover .photo-meta,
  .photo-card:focus-visible .photo-meta {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .photo-meta {
      opacity: 1;
      transform: none;
    }
  }
</style>
