---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { contact, socials } from '../data/site';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapsQuery)}`;
const embedUrl = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapsQuery)}&output=embed`;
---

<Layout title="İletişim" description="Uğur Durmaz iletişim bilgileri: adres, telefon, e-posta ve mesaj formu.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Bize ulaşın</p>
      <h1 class="h-display">İletişim</h1>
      <p class="lead">Projeniz, çekim talebiniz ya da teknik destek ihtiyacınız için bize yazın veya arayın.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="info">
        <h2 class="col-title">İletişim bilgileri</h2>
        <ul class="cards">
          <li class="reveal">
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="card">
              <span class="ico"><Icon name="map-pin" size={22} /></span>
              <span><span class="label">Adres</span>{contact.addressLines.map((l) => <span class="line">{l}</span>)}</span>
            </a>
          </li>
          {
            contact.tel && contact.tel !== contact.gsm && (
              <li class="reveal" style="--delay:50ms">
                <a href={contact.telHref} class="card">
                  <span class="ico"><Icon name="phone" size={22} /></span>
                  <span><span class="label">Telefon</span><span class="line">{contact.tel}</span></span>
                </a>
              </li>
            )
          }
          <li class="reveal" style="--delay:100ms">
            <a href={contact.gsmHref} class="card">
              <span class="ico"><Icon name={contact.tel === contact.gsm ? 'phone' : 'smartphone'} size={22} /></span>
              <span><span class="label">{contact.tel === contact.gsm ? 'Telefon' : 'GSM'}</span><span class="line">{contact.gsm}</span></span>
            </a>
          </li>
          <li class="reveal" style="--delay:150ms">
            <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="card">
              <span class="ico"><Icon name="message-circle" size={22} /></span>
              <span><span class="label">WhatsApp</span><span class="line">Mesaj gönder</span></span>
            </a>
          </li>
          <li class="reveal" style="--delay:200ms">
            <a href={`mailto:${contact.email}`} class="card">
              <span class="ico"><Icon name="mail" size={22} /></span>
              <span><span class="label">E-posta</span><span class="line">{contact.email}</span></span>
            </a>
          </li>
          <li class="reveal" style="--delay:250ms">
            <a href={contact.instagram} target="_blank" rel="noopener noreferrer" class="card">
              <span class="ico"><Icon name="instagram" size={22} /></span>
              <span><span class="label">Instagram</span><span class="line">{contact.instagramHandle}</span></span>
            </a>
          </li>
        </ul>
        <ul class="socials-row">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.icon} size={18} /> {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="form-wrap reveal">
        <h2 class="col-title">Mesaj gönderin</h2>
        <form class="form" data-contact-form novalidate>
          <div class="field">
            <label for="name">Adınız <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-err" />
            <p class="err" id="name-err" role="alert"></p>
          </div>
          <div class="field">
            <label for="email">E-posta <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-err" />
            <p class="err" id="email-err" role="alert"></p>
          </div>
          <div class="field">
            <label for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
          <div class="field">
            <label for="message">Mesajınız <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5" required aria-describedby="message-err"></textarea>
            <p class="err" id="message-err" role="alert"></p>
          </div>
          <button type="submit" class="btn btn-primary">Gönder <Icon name="send" size={18} /></button>
          <p class="hint">Gönder'e bastığınızda mesajınız e-posta uygulamanızda hazır olarak açılır.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="map" aria-label="Harita">
    <iframe
      src={embedUrl}
      title="CTC Bilişim ve Görsel Tasarım konumu, Gaziosmanpaşa İstanbul"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Layout>

<script define:vars={{ to: contact.email }}>
  const form = document.querySelector('[data-contact-form]');
  const messages = {
    name: 'Lütfen adınızı yazın.',
    email: 'Lütfen geçerli bir e-posta adresi yazın (ör. ad@alan.com).',
    message: 'Lütfen mesajınızı yazın.',
  };
  const check = (el) => {
    const err = form.querySelector(`#${el.id}-err`);
    if (!err) return true;
    const ok = el.checkValidity() && el.value.trim() !== '';
    el.setAttribute('aria-invalid', String(!ok));
    err.textContent = ok ? '' : messages[el.name];
    return ok;
  };
  form.querySelectorAll('[required]').forEach((el) => el.addEventListener('blur', () => check(el)));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fields = [...form.querySelectorAll('[required]')];
    const invalid = fields.filter((el) => !check(el));
    if (invalid.length) {
      invalid[0].focus();
      return;
    }
    const d = new FormData(form);
    const body = `${d.get('message')}\n\n—\n${d.get('name')}\n${d.get('email')}\n${d.get('phone') || ''}`;
    window.location.href = `mailto:${to}?subject=${encodeURIComponent('Web sitesinden mesaj – ' + d.get('name'))}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 5fr 6fr;
    }
  }

  .col-title {
    font-size: 1.5rem;
    margin-bottom: 24px;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .card {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgb(233 162 59 / 0.12);
    color: var(--accent);
  }

  .label {
    display: block;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .line {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    word-break: break-word;
  }

  .socials-row {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .socials-row a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .socials-row a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .form-wrap {
    padding: clamp(24px, 4vw, 44px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .form {
    display: grid;
    gap: 20px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  label {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  label span {
    color: var(--accent);
  }

  input,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    transition: border-color var(--dur) var(--ease-out);
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: rgb(255 255 255 / 0.3);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }

  [aria-invalid='true'] {
    border-color: #f87171;
  }

  .err {
    font-size: 0.875rem;
    color: #fca5a5;
  }

  .err:empty {
    display: none;
  }

  .form .btn {
    justify-self: start;
  }

  .hint {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .map {
    height: clamp(320px, 45vw, 480px);
    border-top: 1px solid var(--line);
  }

  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) invert(0.92) contrast(0.9);
  }
</style>
